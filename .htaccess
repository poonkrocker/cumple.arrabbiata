# ============================================================
# Arrabbiata · Armá tu pizza — optimización de entrega
# Va en la raíz del subdominio (cumple.arrabbiata.com.ar)
# ============================================================

# ---- Compresión ----
# El editor y el ingredients.json son casi todo base64: comprimen a ~1/3.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Cache ----
<IfModule mod_headers.c>
  # HTML y biblioteca de ingredientes: siempre revalidar (ETag -> 304 si no
  # cambió, así no se re-descarga, pero si actualizás se ve enseguida).
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Estáticos que no cambian: cache largo.
  <FilesMatch "\.(png|jpe?g|webp|gif|ico|svg|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ---- Cabeceras de seguridad (livianas, no rompen el sitio) ----
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---- No listar directorios ----
Options -Indexes
